# Local storage: leave empty for an existing legacy file-storage volume.
# Fresh installer sets these; never change them to migrate existing data.
# See docs/local-storage.md. Metadata is non-secret, host-verified deployment information.
LOCAL_STORAGE_SOURCE=
LOCAL_STORAGE_MOUNT_TYPE=
LOCAL_STORAGE_HOST_ROOT=
LOCAL_STORAGE_CONTAINER_ROOT=
LOCAL_STORAGE_DEVICE=
LOCAL_STORAGE_INODE=

###############################################################################
# TG Vault 环境变量模板
#
# 使用 deploy/install.sh 时无需复制本文件，安装器会询问地址并生成数据库密码。
# 手动复制为 .env 时，请替换两个示例地址；直接运行 Compose 还需生成 DB_PASSWORD。
# Telegram 不在这里配置；启动后在 Web「设置 → Telegram」配置 Bot 和下载账号。
###############################################################################

# Web 访问 API 的完整 origin，容器启动时生效；不带路径或末尾 /，生产环境使用 HTTPS
VITE_API_URL=https://api.example.com

# 必填：允许访问 API 的 Web 前端来源；多个来源用英文逗号分隔
CORS_ORIGIN=https://cloud.example.com

# 自动生成：不要手工改动已有部署的数据库密码
DB_PASSWORD=

# =============================================================================
# 可选：反向代理与更新检测
# =============================================================================

# 高级覆盖：OAuth 默认分别使用 VITE_API_URL 和 CORS_ORIGIN；多入口反代时再单独覆盖
OAUTH_CALLBACK_BASE_URL=
OAUTH_FRONTEND_ORIGIN=

# 应用默认始终拉取 latest；仅源码兜底时由安装器注入版本信息。
# 不要把 IMAGE_VERSION、SOURCE_REVISION、SOURCE_VERSION 写入 .env。

# 新版本检测（默认开启）
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_REPOSITORY=hicocos/tg-vault

# 宿主机映射端口；反向代理目标分别是 47832（Web）和 PORT（API）
PORT=51947

# =============================================================================
# 高级配置：默认值适用于常规部署，修改前确认影响范围
# =============================================================================

# 容器内数据目录。正常部署保持默认值；实际数据由安装器选择的目录或已有持久卷承载。
UPLOAD_DIR=/data/uploads
THUMBNAIL_DIR=/data/thumbnails
PREVIEW_DIR=/data/previews
CHUNK_DIR=/data/chunks
TG_VAULT_SECRET_DIR=/data/secrets

# 安全与上传保护。生产环境保持默认值。
TRUST_PROXY=loopback
COOKIE_SECURE=true
COOKIE_SECURE_FORCE=
JSON_BODY_LIMIT=2mb
MAX_UPLOAD_CHUNK_MB=32
MAX_CHUNK_UPLOAD_GB=20
CHUNK_GLOBAL_BUDGET_GB=40
CHUNK_DISK_RESERVE_GB=8
MAX_TOTAL_CHUNKS=50000
CHUNK_SESSION_TTL_MS=86400000
CHUNK_COMPLETION_LEASE_MS=1800000
ORPHAN_CLEANUP_MIN_AGE_MS=600000

# 未显式配置的内部密钥保存在 /data/secrets；迁移时同时备份 .env 和完整数据卷。
# 不要替换已有密钥，否则 TOTP 和存储凭证可能无法解密。
SESSION_SECRET=
STORAGE_CREDENTIALS_SECRET=
TOTP_SECRET=

# 存储连接超时与安全策略。生产环境保持默认值。
ALLOW_INSECURE_STORAGE_ENDPOINTS=false
STORAGE_PROBE_TIMEOUT_MS=15000
WEBDAV_INACTIVITY_TIMEOUT_MS=300000
WEBDAV_UPLOAD_TIMEOUT_MS=21600000

# 文件行为与日志。Telegram 下载并发等运行设置请在 Web 中调整。
DUPLICATE_FILE_MODE=copy
AUTO_CLEANUP_ORPHANS=true
LOG_LEVEL=info
SQL_LOG_SLOW_MS=500
SQL_LOG_ALL=false

# 频道后台任务、磁盘保护和调试参数通常无需设置；默认值见 docker-compose.yml。
